# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/threatweaver

# JWT Authentication
JWT_SECRET=your-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Task Queue
TASK_QUEUE_MODE=background
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
ENABLE_REMOTE_LLM=true
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=your_gemini_api_key_here

# Monitoring
MONITOR_SCHEDULER_ENABLED=true
MONITOR_SCHEDULER_POLL_SECONDS=30
MONITOR_MIN_INTERVAL_SECONDS=60
MONITOR_DIFF_RISK_DELTA_THRESHOLD=0.5

# Nmap
NMAP_BINARY_PATH=C:\Program Files (x86)\Nmap\nmap.exe
NMAP_DEFAULT_ARGS=-sn
NMAP_SCAN_TIMEOUT=300

# Vulnerability Databases
NVD_ENABLED=true
NVD_API_KEY=your_nvd_api_key_here

# Shodan (optional)
SHODAN_ENABLED=true
SHODAN_API_KEY=your_shodan_key_here

# CISA Known Exploited Vulnerabilities
CISA_KEV_ENABLED=true